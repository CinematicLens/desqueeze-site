---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { careNotes, clinic, physicians } from '../data/clinic';

const heroImage =
	'https://images.unsplash.com/photo-1631217868264-e5b90bb7e133?auto=format&fit=crop&w=2400&q=80';
---

<Layout title={`${clinic.name} — ${clinic.tagline}`} description="Primary care clinic for families. Book a visit with physicians who know your story.">
	<SiteHeader />

	<main>
		<section class="relative min-h-[100svh] overflow-hidden bg-[var(--ink)] text-[var(--foam)]" aria-label="Hero">
			<img
				src={heroImage}
				alt="Physician speaking with a patient in a calm clinic room"
				class="hero-media absolute inset-0 h-full w-full object-cover"
				width="2400"
				height="1600"
				fetchpriority="high"
			/>
			<div class="absolute inset-0 bg-[linear-gradient(105deg,rgba(15,44,42,0.88)_8%,rgba(15,44,42,0.55)_48%,rgba(15,44,42,0.28)_100%)]"></div>
			<div class="absolute inset-0 bg-[radial-gradient(circle_at_80%_20%,rgba(201,137,58,0.18),transparent_35%)]"></div>

			<div class="page-shell relative flex min-h-[100svh] flex-col justify-end pb-16 pt-28 sm:pb-20 md:justify-center md:pb-24">
				<div class="max-w-2xl">
					<p class="anim-rise brand-font text-4xl leading-none tracking-tight sm:text-5xl md:text-6xl lg:text-7xl">
						{clinic.name}
					</p>
					<span class="accent-line mt-5 block h-px w-28 bg-[var(--sun)]" aria-hidden="true"></span>
					<h1 class="anim-rise-delay mt-6 max-w-xl text-2xl font-semibold leading-snug text-[var(--foam)] sm:text-3xl">
						Steady medicine for the people who live here.
					</h1>
					<p class="anim-rise-late mt-4 max-w-lg text-base leading-relaxed text-[var(--mist)] sm:text-lg">
						Primary care with time to listen, clear plans, and physicians who stay with your family season after season.
					</p>
					<div class="anim-rise-late mt-8 flex flex-wrap items-center gap-3">
						<a
							href="#visit"
							class="rounded-md bg-[var(--sun)] px-5 py-3 text-sm font-semibold text-[var(--ink)] transition hover:brightness-105"
						>
							Book a visit
						</a>
						<a
							href="#physicians"
							class="rounded-md border border-[color-mix(in_oklab,var(--foam)_35%,transparent)] px-5 py-3 text-sm font-semibold text-[var(--foam)] transition hover:bg-white/10"
						>
							Meet physicians
						</a>
					</div>
				</div>
			</div>
		</section>

		<section id="care" class="page-shell py-20 md:py-28">
			<div class="max-w-2xl">
				<p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--leaf)]">How we care</p>
				<h2 class="brand-font mt-3 text-3xl text-[var(--ink)] sm:text-4xl">One purpose: keep you well without the rush.</h2>
				<p class="mt-4 text-lg leading-relaxed text-[var(--ink-soft)]">
					Rivermead Doctors is a neighborhood clinic built around continuity. We leave room in the day for questions, follow-ups, and the kind of attention that actually changes outcomes.
				</p>
			</div>

			<ul class="mt-12 grid gap-10 md:grid-cols-3">
				{
					careNotes.map((note) => (
						<li>
							<h3 class="brand-font text-2xl text-[var(--ink)]">{note.title}</h3>
							<p class="mt-3 text-[var(--ink-soft)] leading-relaxed">{note.copy}</p>
						</li>
					))
				}
			</ul>
		</section>

		<section id="physicians" class="border-y border-[color-mix(in_oklab,var(--leaf)_16%,transparent)] bg-[color-mix(in_oklab,var(--mist)_55%,white)] py-20 md:py-28">
			<div class="page-shell">
				<div class="max-w-2xl">
					<p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--leaf)]">Physicians</p>
					<h2 class="brand-font mt-3 text-3xl text-[var(--ink)] sm:text-4xl">A small team, intentionally so.</h2>
					<p class="mt-4 text-lg leading-relaxed text-[var(--ink-soft)]">
						You will recognize the same faces at the desk and in the exam room.
					</p>
				</div>

				<ul class="mt-12 grid gap-x-10 gap-y-12 md:grid-cols-3">
					{
						physicians.map((doctor) => (
							<li>
								<p class="brand-font text-2xl text-[var(--ink)]">{doctor.name}</p>
								<p class="mt-1 text-sm font-semibold uppercase tracking-[0.14em] text-[var(--leaf)]">{doctor.role}</p>
								<p class="mt-3 leading-relaxed text-[var(--ink-soft)]">{doctor.focus}</p>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<section id="visit" class="page-shell py-20 md:py-28">
			<div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-end">
				<div>
					<p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--leaf)]">Visit</p>
					<h2 class="brand-font mt-3 text-3xl text-[var(--ink)] sm:text-4xl">Come in when you need us.</h2>
					<p class="mt-4 max-w-xl text-lg leading-relaxed text-[var(--ink-soft)]">
						Call the front desk or write us a note. We help new patients get started without a maze of portals.
					</p>
					<div class="mt-8 flex flex-wrap gap-3">
						<a
							href={`tel:${clinic.phone.replace(/\s/g, '')}`}
							class="rounded-md bg-[var(--leaf)] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[var(--leaf-deep)]"
						>
							Call {clinic.phone}
						</a>
						<a
							href={`mailto:${clinic.email}`}
							class="rounded-md border border-[color-mix(in_oklab,var(--ink)_18%,transparent)] px-5 py-3 text-sm font-semibold text-[var(--ink)] transition hover:bg-white/70"
						>
							Email the clinic
						</a>
					</div>
				</div>

				<div class="border-l-2 border-[var(--sun)] pl-6">
					<p class="text-sm font-semibold uppercase tracking-[0.16em] text-[var(--ink-soft)]">Hours</p>
					<ul class="mt-4 space-y-3">
						{
							clinic.hours.map((row) => (
								<li class="flex items-baseline justify-between gap-6 text-[var(--ink)]">
									<span class="font-medium">{row.day}</span>
									<span class="text-[var(--ink-soft)]">{row.time}</span>
								</li>
							))
						}
					</ul>
					<p class="mt-6 text-sm text-[var(--ink-soft)]">{clinic.address}</p>
				</div>
			</div>
		</section>
	</main>

	<SiteFooter />
</Layout>
