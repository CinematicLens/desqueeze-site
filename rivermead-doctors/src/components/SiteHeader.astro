---
import { clinic } from '../data/clinic';
---

<header class="absolute inset-x-0 top-0 z-20">
	<div class="page-shell flex items-center justify-between py-5 text-[var(--foam)]">
		<a href="/" class="brand-font text-xl tracking-tight sm:text-2xl" aria-label={`${clinic.name} home`}>
			{clinic.name}
		</a>
		<nav class="hidden items-center gap-8 text-sm font-medium text-[var(--mist)] md:flex" aria-label="Primary">
			<a class="transition hover:text-white" href="#care">Care</a>
			<a class="transition hover:text-white" href="#physicians">Physicians</a>
			<a class="transition hover:text-white" href="#visit">Visit</a>
		</nav>
		<a
			href="#visit"
			class="rounded-md bg-[var(--sun)] px-3.5 py-2 text-sm font-semibold text-[var(--ink)] transition hover:brightness-105"
		>
			Book a visit
		</a>
	</div>
</header>
